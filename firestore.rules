rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public quote/booking requests from the website's order form.
    // Anyone can CREATE a request (that's the whole point of the form),
    // but nobody can read, list, edit or delete requests from the client —
    // that data is only ever viewed via the Firebase console or an
    // authenticated admin tool, so other visitors' contact info stays private.
    match /requests/{requestId} {
      allow create: if isValidRequest(request.resource.data);
      allow read, update, delete: if false;
    }

    // Email notification docs, consumed by the "Trigger Email from
    // Firestore" extension (see README). The recipient is hardcoded here
    // (not taken from the client) so this can't be abused to spam
    // arbitrary addresses — it can only ever notify the business owner.
    match /mail/{mailId} {
      allow create: if isValidMail(request.resource.data);
      allow read, update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isValidRequest(data) {
    return data.keys().hasOnly(['name', 'phone', 'service', 'area', 'message', 'createdAt'])
      && data.keys().hasAll(['name', 'phone', 'service', 'createdAt'])
      && data.name is string && data.name.size() > 0 && data.name.size() <= 200
      && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50
      && data['service'] is string && data['service'] in ['snow', 'grass', 'other']
      && (!('area' in data) || (data.area is string && data.area.size() <= 200))
      && (!('message' in data) || (data.message is string && data.message.size() <= 2000))
      && data.createdAt == request.time;
  }

  function isValidMail(data) {
    return data.keys().hasOnly(['to', 'message', 'createdAt'])
      && data.to is list && data.to.size() == 1
      && data.to[0] == 'tomhste@gmail.com'
      && data.message is map
      && data.message.keys().hasOnly(['subject', 'text'])
      && data.message.subject is string && data.message.subject.size() <= 200
      && data.message.text is string && data.message.text.size() <= 3000
      && data.createdAt == request.time;
  }
}
